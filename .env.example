# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). .env.local is gitignored - never commit
# real values.

# Safe to expose to the browser - Supabase's anon key is meant to be public
# and is constrained entirely by the RLS policies in supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security - never send this to the
# browser, never prefix it with NEXT_PUBLIC_. Used only by
# scripts/seed-platform-admin.mjs to create the first platform account.
SUPABASE_SERVICE_ROLE_KEY=
